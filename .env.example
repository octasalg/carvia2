# ============================================================
# CARVÍA — Variables de entorno
# Copia este archivo como .env y llena los valores
# ============================================================

# --- Supabase ---
# Solo se usan claves PÚBLICAS (URL + anon key). El frontend NO necesita
# ni debe incluir la SUPABASE_SERVICE_ROLE_KEY (es secreta, solo backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- EmailJS ---
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- WhatsApp ---
# Formato: 521 + LADA (3 dígitos) + número (7 dígitos)
VITE_WHATSAPP_NUMBER=5216141234567

# --- Meta Pixel (dato público, se integra al build de Vite) ---
VITE_META_PIXEL_ID=920694894141920

# --- Feed dinámico para Meta Commerce Manager (solo servidor) ---
# Genera un valor largo y aleatorio. Nunca uses el prefijo VITE_ para este secreto.
META_CATALOG_FEED_TOKEN=
# Dominio público canónico, sin diagonal final.
PUBLIC_BASE_URL=https://www.tudominio.com
